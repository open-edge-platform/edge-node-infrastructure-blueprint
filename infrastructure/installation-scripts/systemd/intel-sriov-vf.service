[Unit]
Description=Intel iGPU SR-IOV VF setup (oneshot, boot-time)
DefaultDependencies=no
# card number varies by platform (e.g. card0 on PTL, card1 on ARL); wait for udev to settle
# instead of pinning to one card's device unit, so the condition below isn't checked too early.
After=systemd-modules-load.service local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=docker.service containerd.service k3s.service kubelet.service basic.target display-manager.service
ConditionPathExistsGlob=/sys/class/drm/card[0-9]*/device/sriov_totalvfs
ConditionPathExists=/opt/edge/scripts/container_setup_sriov.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/edge/scripts/container_setup_sriov.sh
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
